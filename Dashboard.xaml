<Window x:Class="ClaudeAlerta.Dashboard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Loc.AppTitle}" Width="1060" Height="800" MinWidth="900" MinHeight="740" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource Surface}" FontFamily="{DynamicResource UiFont}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ClaroTheme.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="{DynamicResource Surface}" /></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="{DynamicResource Surface}" /></Style>
  <Style x:Key="Rows" TargetType="ListBox"><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityLabel}" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" /></Style></Setter.Value></Setter>
  </Style>
 </ResourceDictionary></Window.Resources>
 <Grid Background="{DynamicResource Surface}">
  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid x:Name="MainContent" Margin="26,22,26,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="MonitorDot" Width="6" Height="6" Fill="{DynamicResource Success}" Margin="0,0,7,0" /><TextBlock x:Name="MonitorLabel" Style="{StaticResource SecondaryText}" /></StackPanel>
     <TextBlock x:Name="Headline" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,5" TextWrapping="Wrap" />
     <TextBlock Text="{DynamicResource Loc.QueueSubtitle}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
    </StackPanel>
    <Button x:Name="PreferencesButton" Grid.Column="1" Content="{DynamicResource Loc.Preferences}" Style="{StaticResource QuietButton}" VerticalAlignment="Top" Click="Preferences_Click" />
    <Popup x:Name="PreferencesPopup" PlacementTarget="{Binding ElementName=PreferencesButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="20" Width="350">
      <StackPanel><TextBlock Text="{DynamicResource Loc.Preferences}" FontSize="16" FontWeight="SemiBold" />
       <CheckBox x:Name="SoundToggle" Content="{DynamicResource Loc.Sound}" Style="{StaticResource SettingToggle}" Checked="Sound_Changed" Unchecked="Sound_Changed" AutomationProperties.Name="{DynamicResource Loc.Sound}" />
       <CheckBox x:Name="PopupToggle" Content="{DynamicResource Loc.Popup}" Style="{StaticResource SettingToggle}" Checked="Popup_Changed" Unchecked="Popup_Changed" AutomationProperties.Name="{DynamicResource Loc.Popup}" />
       <TextBlock Text="{DynamicResource Loc.RemindersLabel}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,16,0,8" />
       <ComboBox x:Name="ReminderSelect" SelectionChanged="Reminder_Changed" AutomationProperties.Name="{DynamicResource Loc.ReminderAccessible}"><ComboBoxItem Content="{DynamicResource Loc.ReminderProgressive}" /><ComboBoxItem Content="{DynamicResource Loc.ReminderNone}" /><ComboBoxItem Content="{DynamicResource Loc.Reminder30}" /><ComboBoxItem Content="{DynamicResource Loc.Reminder60}" /><ComboBoxItem Content="{DynamicResource Loc.Reminder120}" /></ComboBox>
       <TextBlock Text="{DynamicResource Loc.ReminderLimit}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,12" />
       <Button x:Name="TestButton" Content="{DynamicResource Loc.TestAlert}" Click="Test_Click" />
       <Button x:Name="IntegrationButton" Content="{DynamicResource Loc.IntegrationActivate}" Click="Integration_Click" Style="{StaticResource LinkButton}" Margin="0,6,0,0" />
      </StackPanel>
     </Border>
    </Popup>
   </Grid>
   <TabControl x:Name="MainTabs" Grid.Row="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}">
    <TabItem Header="{DynamicResource Loc.AttentionTab}">
     <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TabControl x:Name="QueueTabs" SelectionChanged="Queue_Changed" BorderThickness="0" Margin="0,0,0,12"><TabItem Header="{DynamicResource Loc.PendingTab}" /><TabItem Header="{DynamicResource Loc.WorkingTab}" /><TabItem Header="{DynamicResource Loc.RecentTab}" /></TabControl>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
       <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0"><Grid>
        <ListBox x:Name="SessionsList" Style="{StaticResource Rows}" SelectionChanged="Session_Selected" MouseDoubleClick="Session_DoubleClick" AutomationProperties.Name="{DynamicResource Loc.SessionsAccessible}">
         <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Project}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" /><TextBlock Text="{Binding SessionLabel}" Style="{StaticResource SecondaryText}" Margin="0,4,0,6" /><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding Time}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" Margin="22"><TextBlock Text="{DynamicResource Loc.EmptyQueue}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Loc.EmptyHint}" Style="{StaticResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel>
       </Grid></Border>
       <Border Grid.Column="1" Background="{DynamicResource Ground}" CornerRadius="8" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <TextBlock x:Name="DetailStatus" Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap" />
        <TextBlock x:Name="DetailProject" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,8,0,5" />
        <TextBlock x:Name="DetailFolder" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <TextBlock x:Name="DetailSession" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,5" />
        <TextBlock x:Name="DetailTool" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
        <TextBlock x:Name="DetailWait" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,12" />
        <Button x:Name="OpenCodeButton" Content="{DynamicResource Loc.OpenProject}" Click="OpenCode_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{DynamicResource Loc.OpenProject}" />
        <Grid x:Name="DeferPanel" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="DeferSelect" SelectedIndex="1" AutomationProperties.Name="{DynamicResource Loc.DeferFor}"><ComboBoxItem Content="{DynamicResource Loc.Minutes5}" /><ComboBoxItem Content="{DynamicResource Loc.Minutes15}" /><ComboBoxItem Content="{DynamicResource Loc.Minutes30}" /></ComboBox><Button x:Name="DeferButton" Grid.Column="1" Content="{DynamicResource Loc.Defer}" Click="Defer_Click" Padding="9,6" Margin="7,0,0,0" /></Grid>
       </StackPanel></ScrollViewer></Border>
      </Grid>
      <TextBlock Grid.Row="2" Text="{DynamicResource Loc.PendingHelp}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,0" />
     </Grid>
    </TabItem>
    <TabItem Header="{DynamicResource Loc.RhythmTab}">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="22"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{DynamicResource Loc.ProfileTitle}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Loc.ProfileHelp}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,16" />
       <ComboBox x:Name="ProfileSelect" SelectionChanged="Profile_Changed" AutomationProperties.Name="{DynamicResource Loc.ProfileTitle}"><ComboBoxItem Content="{DynamicResource Loc.ProfileNormal}" /><ComboBoxItem Content="{DynamicResource Loc.ProfileBusy}" /><ComboBoxItem Content="{DynamicResource Loc.ProfileSilent}" /></ComboBox>
       <CheckBox x:Name="ProfileAction" Content="{DynamicResource Loc.RuleAction}" Style="{StaticResource SettingToggle}" Checked="ProfileRule_Changed" Unchecked="ProfileRule_Changed" />
       <CheckBox x:Name="ProfileDone" Content="{DynamicResource Loc.RuleDone}" Style="{StaticResource SettingToggle}" Checked="ProfileRule_Changed" Unchecked="ProfileRule_Changed" />
       <CheckBox x:Name="ProfileError" Content="{DynamicResource Loc.RuleError}" Style="{StaticResource SettingToggle}" Checked="ProfileRule_Changed" Unchecked="ProfileRule_Changed" />
       <CheckBox x:Name="ProfileSound" Content="{DynamicResource Loc.Sound}" Style="{StaticResource SettingToggle}" Checked="ProfileRule_Changed" Unchecked="ProfileRule_Changed" />
       <TextBlock Text="{DynamicResource Loc.ResumeLabel}" Style="{StaticResource SecondaryText}" Margin="0,18,0,8" />
       <ComboBox x:Name="ResumeSelect" SelectionChanged="Resume_Changed" AutomationProperties.Name="{DynamicResource Loc.ResumeLabel}"><ComboBoxItem Content="{DynamicResource Loc.ResumeManual}" /><ComboBoxItem Content="{DynamicResource Loc.Minutes15}" /><ComboBoxItem Content="{DynamicResource Loc.Minutes30}" /><ComboBoxItem Content="{DynamicResource Loc.Minutes60}" /></ComboBox>
       <TextBlock x:Name="ResumeLabel" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Loc.ReturnSummary}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="SummaryLabel" TextWrapping="Wrap" Margin="0,16,0,18" /><Button x:Name="ReturnButton" Content="{DynamicResource Loc.ReturnNormal}" Style="{StaticResource PrimaryButton}" Click="Return_Click" /><TextBlock Text="{DynamicResource Loc.SummaryHelp}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,14,0,0" /></StackPanel>
     </Grid></ScrollViewer>
    </TabItem>
    <TabItem Header="{DynamicResource Loc.ProjectsTab}">
     <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ListBox x:Name="ProjectsList" Style="{StaticResource Rows}" SelectionChanged="Project_Selected" AutomationProperties.Name="{DynamicResource Loc.ProjectsTab}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="20,0,0,0"><StackPanel x:Name="ProjectPanel">
       <TextBlock x:Name="ProjectTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="ProjectFolder" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,14" />
       <TextBlock Text="{DynamicResource Loc.AliasLabel}" Style="{StaticResource SecondaryText}" /><DockPanel Margin="0,7,0,8"><Button x:Name="AliasSaveButton" DockPanel.Dock="Right" Content="{DynamicResource Loc.SaveAlias}" Click="Alias_Click" Margin="8,0,0,0" /><TextBox x:Name="AliasInput" MaxLength="80" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Loc.AliasLabel}" /></DockPanel>
       <CheckBox x:Name="ProjectPin" Content="{DynamicResource Loc.PinProject}" Checked="ProjectRule_Changed" Unchecked="ProjectRule_Changed" Margin="0,8,0,8" />
       <CheckBox x:Name="ProjectMute" Content="{DynamicResource Loc.MuteProject}" Checked="ProjectRule_Changed" Unchecked="ProjectRule_Changed" Margin="0,0,0,8" />
       <CheckBox x:Name="ProjectAction" Content="{DynamicResource Loc.RuleAction}" Style="{StaticResource SettingToggle}" Checked="ProjectRule_Changed" Unchecked="ProjectRule_Changed" />
       <CheckBox x:Name="ProjectDone" Content="{DynamicResource Loc.RuleDone}" Style="{StaticResource SettingToggle}" Checked="ProjectRule_Changed" Unchecked="ProjectRule_Changed" />
       <CheckBox x:Name="ProjectError" Content="{DynamicResource Loc.RuleError}" Style="{StaticResource SettingToggle}" Checked="ProjectRule_Changed" Unchecked="ProjectRule_Changed" />
       <TextBlock Text="{DynamicResource Loc.ProjectReminder}" Style="{StaticResource SecondaryText}" Margin="0,16,0,8" /><ComboBox x:Name="ProjectReminder" SelectionChanged="ProjectReminder_Changed" AutomationProperties.Name="{DynamicResource Loc.ProjectReminder}"><ComboBoxItem Content="{DynamicResource Loc.InheritGlobal}" /><ComboBoxItem Content="{DynamicResource Loc.ReminderProgressive}" /><ComboBoxItem Content="{DynamicResource Loc.ReminderNone}" /><ComboBoxItem Content="{DynamicResource Loc.Reminder30}" /><ComboBoxItem Content="{DynamicResource Loc.Reminder60}" /><ComboBoxItem Content="{DynamicResource Loc.Reminder120}" /></ComboBox>
       <TextBlock Text="{DynamicResource Loc.ProjectRuleHelp}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,9,0,12" />
       <TextBlock x:Name="ProjectSessions" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
      </StackPanel></ScrollViewer>
     </Grid>
    </TabItem>
   </TabControl>
   <StackPanel Grid.Row="2" Margin="0,12,0,0"><DockPanel><Button x:Name="HealthButton" Content="{DynamicResource Loc.CheckIntegration}" Click="Health_Click" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" /><TextBlock x:Name="LastEventLabel" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" TextWrapping="Wrap" /></DockPanel><TextBlock x:Name="HealthLabel" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" /><TextBlock x:Name="FeedbackLabel" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></StackPanel>
  </Grid>
  <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,10"><DockPanel>
   <ComboBox x:Name="LanguageSelect" DockPanel.Dock="Right" Width="152" MinHeight="34" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="Language_Changed" AutomationProperties.Name="{DynamicResource Loc.Language}" />
   <TextBlock x:Name="FooterLabel" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0" />
  </DockPanel></Border>
 </Grid>
</Window>
