<Window x:Class="ClaudeAlerta.Dashboard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Loc.AppTitle}" Width="1100" Height="1000" MinWidth="900" MinHeight="700" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource Surface}" FontFamily="{DynamicResource UiFont}" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ClaroTheme.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="{DynamicResource Surface}" /></Style>
  <Style x:Key="Rows" TargetType="ListBox"><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityLabel}" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowChrome" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource Ground}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource Tint}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
  </Style>
  <Style x:Key="OverviewStatus" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Setter Property="TextWrapping" Value="Wrap" /><Style.Triggers><DataTrigger Binding="{Binding Session.Status}" Value="Trabalhando"><Setter Property="Foreground" Value="{DynamicResource Success}" /></DataTrigger><DataTrigger Binding="{Binding Session.Pending}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></DataTrigger></Style.Triggers></Style>
  <DataTemplate x:Key="QueueItem"><StackPanel Margin="16,15"><TextBlock Text="{Binding Project}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" /><TextBlock Text="{Binding SessionLabel}" Style="{StaticResource SecondaryText}" Margin="0,4,0,6" /><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding Time}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" /></StackPanel></DataTemplate>
 </ResourceDictionary></Window.Resources>
 <Grid Background="{DynamicResource Surface}">
  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="176" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Ground}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><DockPanel Margin="12,25,12,15">
    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Loc.YourMonitor}" Style="{StaticResource SecondaryText}" FontSize="11" Margin="10,0,0,14" />
    <RadioButton x:Name="NavPreferences" DockPanel.Dock="Bottom" Tag="prefs" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource Loc.Preferences}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFont}" Style="{StaticResource NavigationText}" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource Loc.Preferences}" Style="{StaticResource NavigationText}" /></StackPanel></RadioButton>
    <StackPanel>
     <RadioButton x:Name="NavPending" Tag="pending" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource Loc.PendingNav}"><DockPanel><TextBlock x:Name="PendingNavCount" DockPanel.Dock="Right" Style="{StaticResource NavigationText}" FontSize="11" Margin="8,0,0,0" /><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE715;" FontFamily="{DynamicResource IconFont}" Style="{StaticResource NavigationText}" Margin="0,0,10,0" /><TextBlock Text="{DynamicResource Loc.PendingNav}" Style="{StaticResource NavigationText}" /></StackPanel></DockPanel></RadioButton>
     <RadioButton x:Name="NavSessions" Tag="sessions" GroupName="Navigation" IsChecked="True" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource Loc.WorkingTab}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" FontFamily="{DynamicResource IconFont}" Style="{StaticResource NavigationText}" Margin="0,0,10,0" VerticalAlignment="Center" /><StackPanel><TextBlock Text="{DynamicResource Loc.WorkingTab}" Style="{StaticResource NavigationText}" /><TextBlock Text="{DynamicResource Loc.SessionsNavHint}" Style="{StaticResource NavigationText}" FontSize="11" FontWeight="Normal" Margin="0,2,0,0" /></StackPanel></StackPanel></RadioButton>
     <RadioButton x:Name="NavHistory" Tag="history" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource Loc.HistoryNav}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="{DynamicResource IconFont}" Style="{StaticResource NavigationText}" Margin="0,0,10,0" /><TextBlock Text="{DynamicResource Loc.HistoryNav}" Style="{StaticResource NavigationText}" /></StackPanel></RadioButton>
     <RadioButton x:Name="NavProjects" Tag="projects" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked" AutomationProperties.Name="{DynamicResource Loc.ProjectsTab}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource IconFont}" Style="{StaticResource NavigationText}" Margin="0,0,10,0" /><TextBlock Text="{DynamicResource Loc.ProjectsTab}" Style="{StaticResource NavigationText}" /></StackPanel></RadioButton>
    </StackPanel>
   </DockPanel></Border>
   <Grid x:Name="MainContent" Grid.Column="1" Margin="26,24,26,18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="MonitorDot" Width="6" Height="6" Fill="{DynamicResource Success}" Margin="0,0,7,0" /><TextBlock x:Name="MonitorLabel" Style="{StaticResource SecondaryText}" FontSize="11" /></StackPanel><TextBlock x:Name="Headline" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,5" TextWrapping="Wrap" /><TextBlock x:Name="PageSubtitle" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" /></StackPanel>
     <Button x:Name="GlobalProfileButton" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource LinkButton}" Click="Profiles_Click" Margin="18,0,0,0" />
    </Grid>

    <Grid x:Name="QueuePage" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Margin="0,0,18,0"><Grid>
       <ListBox x:Name="SessionsList" Style="{StaticResource Rows}" ItemTemplate="{StaticResource QueueItem}" SelectionChanged="Session_Selected" MouseDoubleClick="Session_DoubleClick" AutomationProperties.Name="{DynamicResource Loc.SessionsAccessible}" />
       <StackPanel x:Name="EmptyState" VerticalAlignment="Center" Margin="22"><TextBlock Text="{DynamicResource Loc.EmptyQueue}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Loc.EmptyHint}" Style="{StaticResource SecondaryText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel>
      </Grid></Border>
      <Border Grid.Column="1" Background="{DynamicResource Ground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
       <TextBlock x:Name="DetailStatus" Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap" /><TextBlock x:Name="DetailProject" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,9,0,6" /><TextBlock x:Name="DetailFolder" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
       <TextBlock x:Name="DetailSession" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,18,0,6" /><TextBlock x:Name="DetailTool" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" /><TextBlock x:Name="DetailWait" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,15" />
       <Button x:Name="OpenCodeButton" Content="{DynamicResource Loc.OpenProject}" Click="OpenCode_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{DynamicResource Loc.OpenProject}" />
       <Grid x:Name="DeferPanel" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="DeferSelect" SelectedIndex="1" AutomationProperties.Name="{DynamicResource Loc.DeferFor}"><ComboBoxItem Content="{DynamicResource Loc.Minutes5}" /><ComboBoxItem Content="{DynamicResource Loc.Minutes15}" /><ComboBoxItem Content="{DynamicResource Loc.Minutes30}" /></ComboBox><Button x:Name="DeferButton" Grid.Column="1" Content="{DynamicResource Loc.DeferCompact}" Click="Defer_Click" Padding="10,7" Margin="7,0,0,0" /></Grid>
      </StackPanel></ScrollViewer></Border>
     </Grid><TextBlock Grid.Row="1" x:Name="QueueHelp" Text="{DynamicResource Loc.PendingHelp}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,14,0,0" />
    </Grid>

    <ScrollViewer x:Name="OverviewPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel x:Name="OverviewContent" Margin="0,0,4,4">
     <StackPanel x:Name="SessionOverviewSection"><DockPanel Margin="0,0,0,13"><TextBlock x:Name="OverviewCount" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" /><TextBlock Text="{DynamicResource Loc.Sessions}" FontSize="17" FontWeight="SemiBold" /></DockPanel>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9"><Grid>
       <ListBox x:Name="SessionOverview" Style="{StaticResource Rows}" MaxHeight="226" MouseDoubleClick="Overview_DoubleClick" AutomationProperties.Name="{DynamicResource Loc.SessionsAccessible}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="15,14"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions><TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" /><StackPanel Grid.Column="1" Margin="10,0,16,0"><TextBlock Text="{Binding Project}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" /><TextBlock Text="{Binding SessionDetails}" ToolTip="{Binding SessionDetails}" Style="{StaticResource SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource OverviewStatus}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
       <TextBlock x:Name="OverviewEmpty" Text="{DynamicResource Loc.EmptyHint}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextAlignment="Center" Margin="24" Visibility="Collapsed" />
      </Grid></Border>
      <DockPanel Margin="0,14,0,0"><Button x:Name="ViewHistoryButton" Content="{DynamicResource Loc.ViewHistory}" Style="{StaticResource LinkButton}" DockPanel.Dock="Right" Click="History_Click" /><StackPanel><TextBlock Text="{DynamicResource Loc.ReturnSummary}" FontSize="12" FontWeight="Medium" /><TextBlock x:Name="SummaryLabel" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,20,0" /></StackPanel></DockPanel>
     </StackPanel>
     <Border x:Name="ProfileSection" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,22,0,0"><StackPanel>
      <TextBlock Text="{DynamicResource Loc.ProfileSectionTitle}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Loc.ProfileScopeHelp}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,16" />
      <Grid x:Name="ProfileCards"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <RadioButton x:Name="NormalProfile" Tag="normal" GroupName="Profiles" Style="{StaticResource ProfileChoice}" Checked="Profile_Checked" AutomationProperties.Name="{DynamicResource Loc.ProfileNormal}" AutomationProperties.HelpText="{DynamicResource Loc.ProfileNormalDescription}"><StackPanel><TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}" FontSize="20" Height="24" /><TextBlock Text="{DynamicResource Loc.ProfileNormal}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,9" /><TextBlock Text="{DynamicResource Loc.ProfileNormalDescription}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" /></StackPanel></RadioButton>
       <RadioButton x:Name="BusyProfile" Grid.Column="2" Tag="busy" GroupName="Profiles" Style="{StaticResource ProfileChoice}" Checked="Profile_Checked" AutomationProperties.Name="{DynamicResource Loc.ProfileBusy}"><StackPanel><TextBlock Text="&#xE769;" Style="{StaticResource Glyph}" FontSize="20" Height="24" /><TextBlock Text="{DynamicResource Loc.ProfileBusy}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,9" /><TextBlock x:Name="BusyDescription" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" /></StackPanel></RadioButton>
       <RadioButton x:Name="SilentProfile" Grid.Column="4" Tag="silent" GroupName="Profiles" Style="{StaticResource ProfileChoice}" Checked="Profile_Checked" AutomationProperties.Name="{DynamicResource Loc.ProfileSilent}" AutomationProperties.HelpText="{DynamicResource Loc.ProfileSilentDescription}"><StackPanel><TextBlock Text="&#xE7ED;" Style="{StaticResource Glyph}" FontSize="20" Height="24" /><TextBlock Text="{DynamicResource Loc.ProfileSilent}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,9" /><TextBlock Text="{DynamicResource Loc.ProfileSilentDescription}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" /></StackPanel></RadioButton>
      </Grid>
      <WrapPanel Margin="0,14,0,0" VerticalAlignment="Center"><TextBlock x:Name="ProfileStateLabel" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,18,0" /><WrapPanel x:Name="ResumeControls" Visibility="Collapsed"><TextBlock Text="{DynamicResource Loc.ResumeLabel}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,9,0" /><ComboBox x:Name="ResumeSelect" Width="165" SelectionChanged="Resume_Changed" AutomationProperties.Name="{DynamicResource Loc.ResumeLabel}"><ComboBoxItem Content="{DynamicResource Loc.ResumeManual}" /><ComboBoxItem Content="{DynamicResource Loc.Minutes15}" /><ComboBoxItem Content="{DynamicResource Loc.Minutes30}" /><ComboBoxItem Content="{DynamicResource Loc.Minutes60}" /></ComboBox><Button x:Name="ReturnButton" Content="{DynamicResource Loc.ReturnCompact}" Click="Return_Click" Margin="8,0,0,0" Padding="12,7" /></WrapPanel></WrapPanel>
      <TextBlock x:Name="ResumeLabel" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,0" />
      <Border x:Name="ProfileRulesSection" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0"><StackPanel><TextBlock x:Name="ProfileRulesTitle" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <CheckBox x:Name="ProfileAction" Content="{DynamicResource Loc.RuleAction}" Style="{StaticResource ProfileRule}" Checked="ProfileRule_Changed" Unchecked="ProfileRule_Changed" AutomationProperties.Name="{DynamicResource Loc.RuleAction}" />
        <CheckBox x:Name="ProfileDone" Grid.Column="2" Content="{DynamicResource Loc.RuleDone}" Style="{StaticResource ProfileRule}" Checked="ProfileRule_Changed" Unchecked="ProfileRule_Changed" AutomationProperties.Name="{DynamicResource Loc.RuleDone}" />
        <CheckBox x:Name="ProfileError" Grid.Row="1" Content="{DynamicResource Loc.RuleError}" Style="{StaticResource ProfileRule}" Checked="ProfileRule_Changed" Unchecked="ProfileRule_Changed" AutomationProperties.Name="{DynamicResource Loc.RuleError}" />
        <CheckBox x:Name="ProfileSound" Grid.Row="1" Grid.Column="2" Content="{DynamicResource Loc.ProfileSound}" Style="{StaticResource ProfileRule}" Checked="ProfileRule_Changed" Unchecked="ProfileRule_Changed" AutomationProperties.Name="{DynamicResource Loc.ProfileSound}" />
       </Grid><TextBlock x:Name="ProfileRulesHelp" Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel></Border>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>

    <Grid x:Name="ProjectsPage" Grid.Row="1" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <ListBox x:Name="ProjectsList" Style="{StaticResource Rows}" SelectionChanged="Project_Selected" AutomationProperties.Name="{DynamicResource Loc.ProjectsTab}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="12"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,0,0,0"><StackPanel x:Name="ProjectPanel" Margin="0,0,4,0"><TextBlock x:Name="ProjectTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="ProjectFolder" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,14" />
      <TextBlock Text="{DynamicResource Loc.AliasLabel}" Style="{StaticResource SecondaryText}" /><DockPanel Margin="0,7,0,8"><Button x:Name="AliasSaveButton" DockPanel.Dock="Right" Content="{DynamicResource Loc.SaveAlias}" Click="Alias_Click" Margin="8,0,0,0" /><TextBox x:Name="AliasInput" MaxLength="80" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Loc.AliasLabel}" /></DockPanel>
      <CheckBox x:Name="ProjectPin" Content="{DynamicResource Loc.PinProject}" Checked="ProjectRule_Changed" Unchecked="ProjectRule_Changed" Margin="0,8,0,8" /><CheckBox x:Name="ProjectMute" Content="{DynamicResource Loc.MuteProject}" Checked="ProjectRule_Changed" Unchecked="ProjectRule_Changed" Margin="0,0,0,8" />
      <CheckBox x:Name="ProjectAction" Content="{DynamicResource Loc.RuleAction}" Style="{StaticResource SettingToggle}" Checked="ProjectRule_Changed" Unchecked="ProjectRule_Changed" /><CheckBox x:Name="ProjectDone" Content="{DynamicResource Loc.RuleDone}" Style="{StaticResource SettingToggle}" Checked="ProjectRule_Changed" Unchecked="ProjectRule_Changed" /><CheckBox x:Name="ProjectError" Content="{DynamicResource Loc.RuleError}" Style="{StaticResource SettingToggle}" Checked="ProjectRule_Changed" Unchecked="ProjectRule_Changed" />
      <TextBlock Text="{DynamicResource Loc.ProjectReminder}" Style="{StaticResource SecondaryText}" Margin="0,16,0,8" /><ComboBox x:Name="ProjectReminder" SelectionChanged="ProjectReminder_Changed" AutomationProperties.Name="{DynamicResource Loc.ProjectReminder}"><ComboBoxItem Content="{DynamicResource Loc.InheritGlobal}" /><ComboBoxItem Content="{DynamicResource Loc.ReminderProgressive}" /><ComboBoxItem Content="{DynamicResource Loc.ReminderNone}" /><ComboBoxItem Content="{DynamicResource Loc.Reminder30}" /><ComboBoxItem Content="{DynamicResource Loc.Reminder60}" /><ComboBoxItem Content="{DynamicResource Loc.Reminder120}" /></ComboBox><TextBlock Text="{DynamicResource Loc.ProjectRuleHelp}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,9,0,12" /><TextBlock x:Name="ProjectSessions" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
     </StackPanel></ScrollViewer>
    </Grid>

    <ScrollViewer x:Name="PreferencesPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="530" HorizontalAlignment="Left" Margin="0,0,10,0">
     <CheckBox x:Name="SoundToggle" Content="{DynamicResource Loc.Sound}" Style="{StaticResource SettingToggle}" Checked="Sound_Changed" Unchecked="Sound_Changed" AutomationProperties.Name="{DynamicResource Loc.Sound}" /><CheckBox x:Name="PopupToggle" Content="{DynamicResource Loc.Popup}" Style="{StaticResource SettingToggle}" Checked="Popup_Changed" Unchecked="Popup_Changed" AutomationProperties.Name="{DynamicResource Loc.Popup}" />
     <TextBlock Text="{DynamicResource Loc.RemindersLabel}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,20,0,8" /><ComboBox x:Name="ReminderSelect" SelectionChanged="Reminder_Changed" AutomationProperties.Name="{DynamicResource Loc.ReminderAccessible}"><ComboBoxItem Content="{DynamicResource Loc.ReminderProgressive}" /><ComboBoxItem Content="{DynamicResource Loc.ReminderNone}" /><ComboBoxItem Content="{DynamicResource Loc.Reminder30}" /><ComboBoxItem Content="{DynamicResource Loc.Reminder60}" /><ComboBoxItem Content="{DynamicResource Loc.Reminder120}" /></ComboBox><TextBlock Text="{DynamicResource Loc.ReminderLimit}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,16" />
     <WrapPanel><Button x:Name="TestButton" Content="{DynamicResource Loc.TestAlert}" Click="Test_Click" /><Button Content="{DynamicResource Loc.ChooseProfile}" Click="Profiles_Click" Style="{StaticResource LinkButton}" Margin="16,0,0,0" /></WrapPanel>
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,22,0,0"><StackPanel><TextBlock Text="{DynamicResource Loc.CheckIntegration}" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="LastEventLabel" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,12" /><WrapPanel><Button x:Name="HealthButton" Content="{DynamicResource Loc.CheckIntegration}" Click="Health_Click" /><Button x:Name="IntegrationButton" Content="{DynamicResource Loc.IntegrationActivate}" Click="Integration_Click" Style="{StaticResource LinkButton}" Margin="16,0,0,0" /></WrapPanel><TextBlock x:Name="HealthLabel" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <TextBlock x:Name="FeedbackLabel" Grid.Row="2" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
   </Grid>
  </Grid>
  <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,10"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,0,8,0" /><ComboBox x:Name="LanguageSelect" Width="150" MinHeight="34" FontSize="12" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="Language_Changed" AutomationProperties.Name="{DynamicResource Loc.Language}" /></StackPanel><TextBlock x:Name="FooterLabel" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0" /></DockPanel></Border>
 </Grid>
</Window>
