<Window x:Class="ClaudeAlerta.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Alerta" Width="940" Height="720" MinWidth="760" MinHeight="660" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}" FontFamily="{DynamicResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ClaroTheme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Background="{DynamicResource Surface}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid x:Name="MainContent" Margin="30,24,30,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="175" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="MonitorDot" Width="6" Height="6" Fill="{DynamicResource Success}" Margin="0,0,7,0" /><TextBlock x:Name="MonitorLabel" Text="Monitoramento ativo" Foreground="{DynamicResource Success}" FontSize="12" FontWeight="Medium" /></StackPanel>
                    <TextBlock Text="Tudo à vista. Sem pressa." FontSize="28" FontWeight="SemiBold" Margin="0,10,0,5" />
                    <TextBlock Text="Um aviso breve quando o Claude precisar de você." Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="OpenCodeButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="20,0,0,0" Click="OpenCode_Click" AutomationProperties.Name="Abrir VS Code">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Abrir VS Code" Foreground="{DynamicResource OnAccent}" /><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" Foreground="{DynamicResource OnAccent}" Margin="10,0,0,0" FontSize="13" /></StackPanel>
                </Button>
            </Grid>
            <DockPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="Suas sessões" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="SessionCount" Text="Nenhuma sessão ainda" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel>
            <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Surface}" ClipToBounds="True">
                <Grid>
                    <ListBox x:Name="SessionsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" Padding="0" MouseDoubleClick="Session_DoubleClick" AutomationProperties.Name="Sessões do Claude Code">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityLabel}" />
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Folder}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="RowChrome" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><ContentPresenter /></Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource Tint}" /></DataTrigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource Tint}" /></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource Ground}" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="18,17" MinHeight="44">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="235" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" Background="{DynamicResource Surface}" CornerRadius="8" VerticalAlignment="Center"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" HorizontalAlignment="Center" FontSize="17" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,16,0"><TextBlock Text="{Binding Project}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" /><TextBlock Text="Claude Code · sessão local" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" /></StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource Glyph}" Foreground="{Binding StatusBrush}" FontSize="15" Margin="0,0,8,0" /><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="203" /></StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Time}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,14" />
                        <TextBlock Text="Aguardando o Claude Code" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Abra uma conversa ou envie uma mensagem para começar." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="3" Margin="0,24,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <CheckBox x:Name="SoundToggle" Style="{StaticResource SettingToggle}" Checked="Sound_Changed" Unchecked="Sound_Changed" AutomationProperties.Name="Som do alerta"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" Foreground="{DynamicResource Ink}" Margin="0,0,10,0" /><TextBlock Text="Som do alerta" /></StackPanel></CheckBox>
                    <CheckBox x:Name="PopupToggle" Style="{StaticResource SettingToggle}" Checked="Popup_Changed" Unchecked="Popup_Changed" AutomationProperties.Name="Aviso de três segundos"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xEA8F;" Foreground="{DynamicResource Ink}" Margin="0,0,10,0" /><TextBlock Text="Aviso de 3 segundos" /></StackPanel></CheckBox>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Label Target="{Binding ElementName=ReminderSelect}" Foreground="{DynamicResource Muted}" FontSize="12" Padding="0" Margin="0,0,0,9">Lembretes de solicitações pendentes</Label>
                    <ComboBox x:Name="ReminderSelect" SelectionChanged="Reminder_Changed" AutomationProperties.Name="Intervalo dos lembretes"><ComboBoxItem>Sem lembrete</ComboBoxItem><ComboBoxItem>A cada 30 segundos</ComboBoxItem><ComboBoxItem>A cada 1 minuto</ComboBoxItem><ComboBoxItem>A cada 2 minutos</ComboBoxItem></ComboBox>
                    <TextBlock Text="O aviso se fecha sozinho. Você decide quando voltar." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0" />
                </StackPanel>
            </Grid>
            <DockPanel Grid.Row="4" LastChildFill="True" Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="PauseButton" Style="{StaticResource QuietButton}" Click="Pause_Click" Margin="0,0,8,0" AutomationProperties.Name="Pausar alertas"><StackPanel Orientation="Horizontal"><TextBlock x:Name="PauseGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" Foreground="{DynamicResource Muted}" Margin="0,0,9,0" /><TextBlock x:Name="PauseLabel" Text="Pausar" Foreground="{DynamicResource Muted}" /></StackPanel></Button>
                    <Button x:Name="TestButton" Click="Test_Click" AutomationProperties.Name="Testar aviso"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xEA8F;" Foreground="{DynamicResource Ink}" Margin="0,0,9,0" /><TextBlock Text="Testar aviso" /></StackPanel></Button>
                </StackPanel>
                <Button x:Name="AcknowledgeButton" Content="Já vi este aviso" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Acknowledge_Click" ToolTip="Interrompe os lembretes da sessão selecionada" Visibility="Hidden" />
            </DockPanel>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface}" Padding="24,12">
            <DockPanel>
                <Button x:Name="IntegrationButton" Content="Ativar integração" Style="{StaticResource LinkButton}" DockPanel.Dock="Right" Click="Integration_Click" Visibility="Collapsed" />
                <TextBlock DockPanel.Dock="Right" Text="Funciona na bandeja do Windows" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" FontSize="14" /><TextBlock x:Name="FooterLabel" Text="Integração ativa" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" /></StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
