<Window x:Class="ClaudeAlerta.AlertCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.ToastWindowTitle}" Width="438" Height="156" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="{DynamicResource UiFont}" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ClaroTheme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid><Border Margin="10" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12">
        <Border.Effect><DropShadowEffect Color="#26384F" BlurRadius="16" ShadowDepth="3" Opacity="0.18" /></Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="3" /></Grid.RowDefinitions>
            <Grid Margin="18,15,16,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}" FontSize="19" VerticalAlignment="Top" Margin="0,3,0,0" />
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel><TextBlock x:Name="Countdown" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" /><TextBlock Text="{DynamicResource Loc.AppTitle}" Style="{StaticResource SecondaryText}" /></DockPanel>
                    <TextBlock x:Name="AlertTitle" Grid.Row="1" Text="{DynamicResource Loc.StatusPermission}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                    <TextBlock x:Name="ProjectLabel" Grid.Row="2" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                    <DockPanel Grid.Row="3" VerticalAlignment="Bottom">
                        <Button x:Name="DeferToastButton" Content="{DynamicResource Loc.DeferShort}" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" FontSize="12" Padding="8,3" MinHeight="30" Click="Acknowledge_Click" />
                        <Button x:Name="ToastOpenButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Open_Click" AutomationProperties.Name="{DynamicResource Loc.OpenCode}"><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource Loc.OpenCode}" Foreground="{DynamicResource Accent}" FontSize="12" /><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" FontSize="12" Margin="8,0,0,0" /></StackPanel></Button>
                    </DockPanel>
                </Grid>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource Ground}" Margin="9,0"><Border x:Name="TimeBar" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="TimeScale" ScaleX="1" /></Border.RenderTransform></Border></Border>
        </Grid>
    </Border></Grid>
</Window>
